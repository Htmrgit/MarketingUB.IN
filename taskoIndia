                    <button onclick="trackTask()" class="btn-primary px-10 py-4">Search</button>
                </div>

                <div id="trackResult" class="hidden mt-10 text-left border-t border-[#E5E5E5] pt-10">
                    <div class="flex justify-between items-center mb-8">
                        <div>
                            <span id="resId" class="text-[10px] font-bold text-[#666666] bg-gray-100 px-2 py-1 rounded">TASK-7832</span>
                            <h3 id="resName" class="text-xl font-bold mt-2">Delivery from Market</h3>
                        </div>
                        <span id="resStatusBadge" class="light-orange-bg orange-text text-[10px] font-black px-4 py-1 rounded-full uppercase tracking-tighter">In Progress</span>
                    </div>

                    <div class="space-y-6 relative ml-3 border-l-2 border-orange-100 pl-8">
                        <div class="relative">
                            <div class="absolute -left-[41px] top-0 w-4 h-4 rounded-full orange-bg ring-4 ring-orange-50"></div>
                            <p class="text-sm font-bold">Task Created</p>
                            <p class="text-xs text-[#666666]">Successfully posted on the hustle board</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[41px] top-0 w-4 h-4 rounded-full bg-gray-200"></div>
                            <p class="text-sm font-bold text-[#666666]">Hustler En-route</p>
                            <p class="text-xs text-[#666666]">A student runner is moving towards your location</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- EARN PAGE -->
        <section id="earn-section" class="section section-hidden">
            <div class="light-orange-bg p-10 rounded-2xl mb-8 relative overflow-hidden border border-orange-100">
                <div class="relative z-10">
                    <h2 class="text-3xl font-black mb-3 text-[#1F1F1F]">Earn. Study. Repeat.</h2>
                    <p class="text-[#666666] max-w-md font-medium">Join 800+ students earning ₹3,000+ weekly in their free campus hours.</p>
                    <div class="mt-6 flex items-center gap-2 text-xs font-bold orange-text uppercase tracking-widest">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> No Fixed Shifts
                        <span class="mx-2">•</span>
                        <i data-lucide="check-circle" class="w-4 h-4"></i> Instant Payouts
                    </div>
                </div>
            </div>

            <div class="card-modern p-8 mb-12">
                <h3 class="text-xl font-bold mb-8">Runner Registration</h3>
                <form id="runnerForm" onsubmit="handleRunnerSubmit(event)" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">Your Name</label>
                            <input type="text" id="runName" required placeholder="Full Name">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">WhatsApp Number</label>
                            <input type="tel" id="runMobile" required placeholder="+91">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">College / Campus Area</label>
                            <input type="text" id="runArea" required placeholder="e.g. IIT Delhi Area">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">Primary Skill</label>
                            <input type="text" id="runSkill" required placeholder="e.g. Driving / Rapid Typing">
                        </div>
                    </div>
                    <button type="submit" class="btn-primary w-full py-4 text-lg">
                        Apply to Join
                    </button>
                </form>
            </div>
        </section>

    </main>

