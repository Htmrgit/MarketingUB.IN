    <!-- MOBILE BOTTOM NAV -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-[#E5E5E5] px-2 py-3 flex justify-around items-center z-50 shadow-[0_-4px_10px_rgba(0,0,0,0.03)]">
        <button onclick="showSection('home')" id="nav-home" class="flex flex-col items-center gap-1 text-[#666666] transition-all nav-active">
            <i data-lucide="home" class="w-5 h-5"></i>
            <span class="text-[10px] font-bold uppercase tracking-tighter">Home</span>
        </button>
        <button onclick="showSection('runners')" id="nav-runners" class="flex flex-col items-center gap-1 text-[#666666] transition-all">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span class="text-[10px] font-bold uppercase tracking-tighter">Hustlers</span>
        </button>
        <button onclick="showSection('submit')" id="nav-submit" class="flex flex-col items-center gap-1 text-[#666666] transition-all">
            <i data-lucide="plus-circle" class="w-5 h-5"></i>
            <span class="text-[10px] font-bold uppercase tracking-tighter">Post</span>
        </button>
        <button onclick="showSection('track')" id="nav-track" class="flex flex-col items-center gap-1 text-[#666666] transition-all">
