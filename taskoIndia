        <!-- SUBMIT TASK PAGE -->
        <section id="submit-section" class="section section-hidden">
            <div class="card-modern p-8 mb-12">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-10 h-10 orange-bg rounded-xl flex items-center justify-center text-white">
                        <i data-lucide="plus" class="w-6 h-6"></i>
                    </div>
                    <h2 class="text-2xl font-bold">New Task Request</h2>
                </div>

                <form id="taskForm" onsubmit="handleTaskSubmit(event)" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">Full Name</label>
                            <input type="text" id="custName" required placeholder="John Doe">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">Mobile Number</label>
