                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-[#666666] uppercase tracking-wide">What do you need help with?</label>
                        <textarea id="taskDetails" required rows="4" placeholder="Describe your task clearly..."></textarea>
                    </div>

                    <div class="flex items-center gap-3 py-2 bg-orange-50/50 p-4 rounded-xl border border-orange-100">
