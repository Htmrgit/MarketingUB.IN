    <!-- SUCCESS OVERLAY -->
    <div id="successOverlay" class="fixed inset-0 bg-white z-[100] hidden flex items-center justify-center p-6 text-center">
        <div class="max-w-xs">
            <div class="w-24 h-24 orange-bg rounded-full flex items-center justify-center text-white mx-auto mb-8 shadow-xl shadow-orange-100">
                <i data-lucide="check" class="w-12 h-12"></i>
            </div>
            <h2 class="text-3xl font-black mb-4">You're All Set!</h2>
            <p class="text-[#666666] mb-2">Task ID: <span id="displayTaskId" class="font-bold orange-text tracking-widest uppercase">TASK-1234</span></p>
            <p class="text-sm text-[#666666] mb-10 leading-relaxed">Our nearest student runner will verify your request on WhatsApp in just a moment.</p>
            <button onclick="closeSuccess()" class="btn-primary w-full py-5 text-lg">Back to Home</button>
        </div>
    </div>

    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Runner Data
        const runners = [
            { id: 1, name: "Rahul S.", cat: "Professional", skill: "CA Intern", rate: 4.9, tasks: 120, img: "👨‍💼" },
            { id: 2, name: "Priya V.", cat: "Technical", skill: "Software Dev", rate: 4.8, tasks: 85, img: "👩‍💻" },
            { id: 3, name: "Arjun K.", cat: "Marketing", skill: "Digital Marketer", rate: 4.7, tasks: 150, img: "📈" },
            { id: 4, name: "Sneha M.", cat: "Professional", skill: "Legal Advisor", rate: 4.9, tasks: 45, img: "⚖️" },
            { id: 5, name: "Vikram R.", cat: "Technical", skill: "UI/UX Designer", rate: 4.6, tasks: 200, img: "🎨" },
            { id: 6, name: "Amit T.", cat: "Errands", skill: "Fast Delivery", rate: 4.5, tasks: 310, img: "🛵" },
        ];

        // Single Page Navigation Logic
        function showSection(sectionId) {
            document.querySelectorAll('.section').forEach(s => s.classList.add('section-hidden'));
            document.getElementById(`${sectionId}-section`).classList.remove('section-hidden');
            
            // Update Mobile Nav UI
            document.querySelectorAll('[id^="nav-"]').forEach(n => n.classList.remove('nav-active'));
            const activeNav = document.getElementById(`nav-${sectionId}`);
            if(activeNav) activeNav.classList.add('nav-active');

            // Update Desktop Nav UI
            document.querySelectorAll('[id^="dnav-"]').forEach(n => n.classList.remove('nav-active'));
            const activeDNav = document.getElementById(`dnav-${sectionId}`);
            if(activeDNav) activeDNav.classList.add('nav-active');

            if(sectionId === 'home') startCounters();
            if(sectionId === 'runners') filterRunners('All');

            window.scrollTo(0, 0);
        }

        // Runner Filtering
        function filterRunners(category) {
            const grid = document.getElementById('runnerGrid');
            grid.innerHTML = '';
            
            // Update UI
            document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
            document.getElementById(`f-${category}`).classList.add('active');

            const filtered = category === 'All' ? runners : runners.filter(r => r.cat === category);

            filtered.forEach(runner => {
                const card = `
                    <div class="card-modern p-6 flex items-center gap-5 hover:border-[#FF7A00] cursor-pointer group">
                        <div class="w-16 h-16 bg-orange-50 rounded-full flex items-center justify-center text-3xl">
                            ${runner.img}
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-lg">${runner.name}</h3>
                                <div class="flex items-center gap-1 orange-text font-bold text-xs">
                                    <i data-lucide="star" class="w-3 h-3 fill-current"></i> ${runner.rate}
                                </div>
                            </div>
                            <p class="text-xs font-bold text-[#666666] uppercase mt-1">${runner.skill}</p>
                            <p class="text-[10px] text-gray-400 mt-1">${runner.tasks}+ tasks completed</p>
                            <button onclick="showSection('submit')" class="mt-4 text-xs font-bold orange-text group-hover:underline flex items-center gap-1">
                                Hire Hustler <i data-lucide="arrow-right" class="w-3 h-3"></i>
                            </button>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });
            lucide.createIcons();
        }

        // Animated Counters
        function animateValue(id, start, end, duration, suffix = "") {
            const obj = document.getElementById(id);
            if(!obj) return;
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                const val = Math.floor(progress * (end - start) + start);
                obj.innerHTML = val.toLocaleString() + suffix;
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        function startCounters() {
            animateValue("stat-completed", 0, 8420, 1500, "+");
            animateValue("stat-active", 0, 89, 1500);
            animateValue("stat-hustlers", 0, 1250, 1500, "+");
            animateValue("stat-rate", 0, 99, 1500, ".9%");
        }

        window.onload = startCounters;

        function generateTaskId() {
            return 'TASK-' + Math.floor(1000 + Math.random() * 9000);
        }

        async function handleTaskSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            const originalText = btn.innerHTML;
            
            btn.innerHTML = '<div class="spinner"></div>';
            btn.disabled = true;

            const taskId = generateTaskId();
            const data = {
                taskId: taskId,
                name: document.getElementById('custName').value,
                mobile: document.getElementById('custMobile').value,
                type: document.getElementById('taskType').value,
                budget: document.getElementById('budget').value,
                location: document.getElementById('location').value,
                details: document.getElementById('taskDetails').value,
                isUrgent: document.getElementById('urgentTask').checked ? "YES" : "NO",
                timestamp: new Date().toLocaleString()
            };

            const waMessage = `🚀 *New Task @TaskoIndia*%0A------------------------%0A*ID:* ${data.taskId}%0A*Name:* ${data.name}%0A*Location:* ${data.location}%0A*Task:* ${data.details}%0A*Budget:* ₹${data.budget}%0A*Urgent:* ${data.isUrgent}`;
            const waLink = `https://wa.me/919355650312?text=${waMessage}`;

            // Mock Success
            setTimeout(() => {
                document.getElementById('displayTaskId').innerText = taskId;
                document.getElementById('successOverlay').classList.remove('hidden');
                
                setTimeout(() => {
                    window.open(waLink, '_blank');
                }, 1500);

                btn.innerHTML = originalText;
                btn.disabled = false;
                document.getElementById('taskForm').reset();
            }, 800);
        }

        function closeSuccess() {
            document.getElementById('successOverlay').classList.add('hidden');
            showSection('home');
        }

        function handleRunnerSubmit(e) {
            e.preventDefault();
            alert("Application received! Our campus managers will contact you via WhatsApp.");
            document.getElementById('runnerForm').reset();
            showSection('home');
        }

        function trackTask() {
            const idInput = document.getElementById('trackId').value;
            if(!idInput) return;
            const result = document.getElementById('trackResult');
            result.classList.remove('hidden');
            document.getElementById('resId').innerText = idInput.toUpperCase();
        }
    </script>
</body>
</html>
